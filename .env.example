# Copy this file to .env locally and replace every example value.
# Never commit the real .env file or share its secrets in chat.

DATABASE_URL="postgresql://fitloop:fitloop_dev@localhost:5432/fitloop?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
PORT=4000
COACH_SERVICE_URL="http://127.0.0.1:8000"
FRONTEND_ORIGIN="http://localhost:5173"

# Optional external AI coach. Leave blank to keep all conversations rule-guided.
AI_COACH_API_KEY=""
AI_COACH_MODEL="gpt-4.1-mini"
