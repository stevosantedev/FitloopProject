# Dependencies are installed locally and should never be committed.
node_modules/
**/node_modules/

# Build output is generated from source files.
dist/
build/
coverage/
*.log

# Local configuration can contain passwords and signing keys.
.env
.env.*
!.env.example

# Python environments and generated bytecode belong on each developer's machine.
.venv/
venv/
__pycache__/
*.py[cod]

# Editors and operating systems create files that are not part of the application.
.DS_Store
.idea/
.vscode/
